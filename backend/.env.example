# ---- Core (all optional for local demo) --------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/omnisight.db      # PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/omnisight
SECRET_KEY=                                     # REQUIRED in production. Dev mode generates a temporary one.
ENVIRONMENT=development                         # development | production
DATA_DIR=./data                                 # screenshots, fix workspaces

# ---- Scan security ------------------------------------------------------
# Comma-separated hosts (or host:port) you explicitly authorise for scanning.
# Private / loopback / link-local / metadata addresses are blocked unless listed here.
ALLOWED_SCAN_HOSTS=127.0.0.1:5050,localhost:5050
# Directories whose contents may be used as a fix source (isolated copies are made).
ALLOWED_SOURCE_ROOTS=../demo-site

# ---- AI provider (optional; without a key OmniSight runs rule-based demo mode)
AI_PROVIDER=                                    # anthropic | openai | (empty = demo mode)
AI_MODEL=                                       # e.g. a vision-capable model your key can access
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- GitHub (optional; without these the PR flow is clearly-labelled SIMULATED)
GITHUB_TOKEN=                                   # fine-grained token: Contents + Pull requests (read/write)
GITHUB_REPOSITORY=                              # owner/repo
